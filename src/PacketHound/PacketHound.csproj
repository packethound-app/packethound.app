<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- WPF and WinForms both define Application, MessageBox, Button...; keep usings explicit. -->
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Icons are generated from Assets/logo.png by tools/make-icons.py -->
    <ApplicationIcon>Assets\PacketHound.ico</ApplicationIcon>
    <AssemblyName>PacketHound</AssemblyName>
    <RootNamespace>PacketHound</RootNamespace>
    <Version>1.2.0</Version>
    <Product>PacketHound</Product>
    <Description>Outbound application firewall prompt for Windows Firewall</Description>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\PacketHound.ico" />
    <Resource Include="Assets\PacketHound-paused.ico" />
    <Resource Include="Assets\logo.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Management" Version="10.0.14" />
  </ItemGroup>

</Project>
