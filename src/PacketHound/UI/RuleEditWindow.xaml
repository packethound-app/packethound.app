<Window x:Class="PacketHound.UI.RuleEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PacketHound · Edit rule" Icon="/Assets/PacketHound.ico"
        Width="520" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource Window}" FontFamily="Segoe UI" FontSize="13"
        TextOptions.TextFormattingMode="Display">
    <StackPanel Margin="24,22,24,20">
        <!-- Which app -->
        <DockPanel>
            <Border DockPanel.Dock="Left" Width="52" Height="52" CornerRadius="10" Background="{StaticResource Surface}" VerticalAlignment="Top">
                <Image x:Name="AppIcon" Width="32" Height="32" RenderOptions.BitmapScalingMode="HighQuality"/>
            </Border>
            <StackPanel Margin="14,2,0,0" VerticalAlignment="Center">
                <TextBlock x:Name="AppNameText" FontSize="19" FontWeight="SemiBold" Foreground="{StaticResource Ink}" TextWrapping="Wrap"/>
                <TextBlock x:Name="AppPathText" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </DockPanel>

        <!-- The rule -->
        <Grid Margin="2,18,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Style="{StaticResource Label}" Text="Action" VerticalAlignment="Center"/>
            <ComboBox x:Name="ActionBox" Grid.Column="1" Margin="0,3" Padding="8,5" SelectionChanged="Option_Changed">
                <ComboBoxItem Content="Allow"/>
                <ComboBoxItem Content="Block"/>
            </ComboBox>
            <TextBlock Style="{StaticResource Label}" Grid.Row="1" Text="Applies to" VerticalAlignment="Center"/>
            <ComboBox x:Name="ScopeBox" Grid.Row="1" Grid.Column="1" Margin="0,3" Padding="8,5" SelectionChanged="Scope_Changed">
                <ComboBoxItem Content="Any connection"/>
                <ComboBoxItem Content="Only this IP address"/>
                <ComboBoxItem Content="Only this host"/>
                <ComboBoxItem Content="Only this domain and its subdomains"/>
            </ComboBox>
            <TextBlock x:Name="TargetLabel" Style="{StaticResource Label}" Grid.Row="2" VerticalAlignment="Center" Visibility="Collapsed"/>
            <TextBox x:Name="TargetBox" Grid.Row="2" Grid.Column="1" Margin="0,3" Padding="6,5" VerticalContentAlignment="Center"
                     Visibility="Collapsed" TextChanged="Target_TextChanged"/>
            <TextBlock x:Name="TargetError" Grid.Row="3" Grid.Column="1" Margin="0,2,0,0" Foreground="{StaticResource Danger}"
                       FontSize="12" TextWrapping="Wrap" Visibility="Collapsed"/>
            <CheckBox x:Name="KeepBox" Grid.Row="4" Grid.Column="1" Margin="0,8,0,0" Visibility="Collapsed" Click="Option_Changed"/>
        </Grid>

        <!-- Addresses a host or domain rule has collected -->
        <StackPanel x:Name="AddressesPanel" Margin="2,14,0,0" Visibility="Collapsed">
            <TextBlock x:Name="AddressesTitle" Foreground="{StaticResource Muted}" Margin="0,0,0,4" TextWrapping="Wrap"/>
            <ListBox x:Name="AddressesList" MaxHeight="110" BorderBrush="{StaticResource Line}" Foreground="{StaticResource Ink}"
                     FontSize="12" Padding="2"/>
        </StackPanel>

        <TextBlock x:Name="NoteText" Margin="2,14,0,0" Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap"/>

        <Border x:Name="WarningBox" Margin="0,12,0,0" Padding="12,8" CornerRadius="6"
                Background="#FFFBEB" BorderBrush="#FCD34D" BorderThickness="1" Visibility="Collapsed">
            <TextBlock x:Name="WarningText" Foreground="{StaticResource Ink}" TextWrapping="Wrap"/>
        </Border>

        <TextBlock x:Name="SaveError" Margin="2,12,0,0" Foreground="{StaticResource Danger}" TextWrapping="Wrap" Visibility="Collapsed"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button x:Name="CancelButton" Content="Cancel" MinWidth="96" IsCancel="True"/>
            <Button x:Name="SaveButton" Content="Save" Style="{StaticResource PrimaryButton}" MinWidth="96" Margin="10,0,0,0"
                    IsDefault="True" Click="Save_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
