<Window x:Class="PacketHound.UI.PromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PacketHound · Outgoing connection" Icon="/Assets/PacketHound.ico"
        Width="500" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" Topmost="True" ShowActivated="False" ShowInTaskbar="True"
        Background="{StaticResource Window}" FontFamily="Segoe UI" FontSize="13"
        TextOptions.TextFormattingMode="Display">
    <Grid Margin="24,22,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Who -->
        <DockPanel>
            <Border DockPanel.Dock="Left" Width="52" Height="52" CornerRadius="10" Background="{StaticResource Surface}" VerticalAlignment="Top">
                <Image Source="{Binding Icon}" Width="32" Height="32" RenderOptions.BitmapScalingMode="HighQuality"/>
            </Border>
            <StackPanel Margin="14,2,0,0" VerticalAlignment="Center">
                <TextBlock Text="{Binding DisplayName}" FontSize="19" FontWeight="SemiBold" Foreground="{StaticResource Ink}" TextWrapping="Wrap"/>
                <TextBlock Text="is trying to connect to" Foreground="{StaticResource Muted}" Margin="0,2,0,0"/>
            </StackPanel>
        </DockPanel>

        <!-- Where -->
        <Border Grid.Row="1" Margin="0,18,0,0" Padding="14,12" Background="{StaticResource Surface}" CornerRadius="8">
            <StackPanel>
                <TextBlock Text="{Binding DestinationTitle}" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource Ink}" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding DestinationDetail}" Foreground="{StaticResource Muted}" Margin="0,3,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- Details -->
        <Grid Grid.Row="2" Margin="2,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Style="{StaticResource Label}" Text="Publisher"/>
            <TextBlock Style="{StaticResource Value}" Grid.Column="1" Text="{Binding Publisher}"/>
            <TextBlock Style="{StaticResource Label}" Grid.Row="1" Text="Program"/>
            <TextBlock Style="{StaticResource Value}" Grid.Row="1" Grid.Column="1" Text="{Binding AppPath}" FontSize="12"/>
            <TextBlock Style="{StaticResource Label}" Grid.Row="2" Text="Process"/>
            <TextBlock Style="{StaticResource Value}" Grid.Row="2" Grid.Column="1" Text="{Binding ProcessText}"/>
            <TextBlock Style="{StaticResource Label}" Grid.Row="3" Text="Status"/>
            <TextBlock Style="{StaticResource Value}" Grid.Row="3" Grid.Column="1" Text="{Binding AttemptsText}"/>
        </Grid>

        <TextBlock Grid.Row="3" Margin="2,12,0,0" Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap"
                   Text="Your choice is saved as a Windows Firewall rule for every connection this program makes. If you allow it, the program may need to retry."/>

        <!-- Actions -->
        <DockPanel Grid.Row="4" Margin="0,20,0,0" LastChildFill="False">
            <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                <TextBlock>
                    <Hyperlink Click="Later_Click" Foreground="{StaticResource Muted}">Decide later</Hyperlink>
                </TextBlock>
                <TextBlock x:Name="QueueText" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,4,0,0" Visibility="Collapsed"/>
            </StackPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="Block" Style="{StaticResource DangerButton}" MinWidth="96" Click="Block_Click"/>
                <Button Content="Allow" Style="{StaticResource PrimaryButton}" MinWidth="96" Margin="10,0,0,0" Click="Allow_Click"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
