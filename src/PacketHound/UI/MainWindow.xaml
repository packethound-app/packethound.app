<Window x:Class="PacketHound.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PacketHound" Icon="/Assets/PacketHound.ico" Width="1000" Height="640" MinWidth="720" MinHeight="420"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Window}" Foreground="{DynamicResource Ink}" FontFamily="Segoe UI" FontSize="13"
        TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <Style TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource Line}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
            <Setter Property="Background" Value="{DynamicResource Window}"/>
            <Setter Property="RowBackground" Value="{DynamicResource Window}"/>
            <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
            <!-- Rows grow when selected so cut-off text can wrap (see CellText). -->
            <Setter Property="MinRowHeight" Value="30"/>
            <Setter Property="CanUserResizeRows" Value="False"/>
            <Setter Property="SelectionMode" Value="Extended"/>
        </Style>

        <Style x:Key="HeaderGripper" TargetType="Thumb">
            <Setter Property="Width" Value="8"/>
            <Setter Property="Cursor" Value="SizeWE"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="Transparent"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{DynamicResource Surface}"/>
            <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridColumnHeader">
                        <Grid>
                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                                <StackPanel Orientation="Horizontal">
                                    <ContentPresenter VerticalAlignment="Center"/>
                                    <Path x:Name="SortArrow" Width="8" Height="5" Margin="6,1,0,0" Stretch="Fill"
                                          VerticalAlignment="Center" Fill="{DynamicResource Ink}" Visibility="Collapsed"/>
                                </StackPanel>
                            </Border>
                            <Thumb x:Name="PART_LeftHeaderGripper" HorizontalAlignment="Left" Margin="-4,0,0,0" Style="{StaticResource HeaderGripper}"/>
                            <Thumb x:Name="PART_RightHeaderGripper" HorizontalAlignment="Right" Margin="0,0,-4,0" Style="{StaticResource HeaderGripper}"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="SortDirection" Value="Ascending">
                                <Setter TargetName="SortArrow" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="SortArrow" Property="Data" Value="M0,5 L4,0 L8,5 Z"/>
                                <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
                            </Trigger>
                            <Trigger Property="SortDirection" Value="Descending">
                                <Setter TargetName="SortArrow" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="SortArrow" Property="Data" Value="M0,0 L8,0 L4,5 Z"/>
                                <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource SurfaceHover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Text cells: cut off with "…" when too long; the selected row wraps them to show everything. -->
        <Style x:Key="CellText" TargetType="TextBlock">
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True">
                    <Setter Property="TextWrapping" Value="Wrap"/>
                    <Setter Property="TextTrimming" Value="None"/>
                    <Setter Property="Margin" Value="0,6"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SelectionInactive}"/>
                    <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
                </Trigger>
                <MultiTrigger>
                    <MultiTrigger.Conditions>
                        <Condition Property="IsSelected" Value="True"/>
                        <Condition Property="Selector.IsSelectionActive" Value="True"/>
                    </MultiTrigger.Conditions>
                    <Setter Property="Background" Value="{DynamicResource Selection}"/>
                    <Setter Property="Foreground" Value="{DynamicResource SelectionInk}"/>
                </MultiTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- Status banner -->
        <Border DockPanel.Dock="Top" Padding="20,12" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1">
            <DockPanel>
                <Button x:Name="ToggleButton" DockPanel.Dock="Right" VerticalAlignment="Center" MinWidth="170" Click="Toggle_Click"/>
                <Button x:Name="QuietButton" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="0,0,10,0" Click="Quiet_Click"
                        ToolTip="Stop asking about new apps for a while. They stay blocked, and are listed so you can decide later."/>
                <!-- The logo's lettering is dark, so the dark theme puts it on a light plate (transparent in the light theme). -->
                <Border DockPanel.Dock="Left" Background="{DynamicResource LogoPlate}" CornerRadius="8" Padding="6,4"
                        Margin="-6,-4,14,-4" VerticalAlignment="Center">
                    <Image Source="/Assets/logo.png" Height="72" RenderOptions.BitmapScalingMode="HighQuality"/>
                </Border>
                <Rectangle DockPanel.Dock="Left" Width="1" Fill="{DynamicResource Line}" Margin="0,4,20,4"/>
                <Ellipse x:Name="StatusDot" DockPanel.Dock="Left" Width="12" Height="12" Margin="0,0,12,0" VerticalAlignment="Center"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="StatusTitle" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource Ink}"/>
                    <TextBlock x:Name="StatusDetail" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,2,16,0"/>
                    <TextBlock x:Name="QuietText" Foreground="{DynamicResource Warning}" TextWrapping="Wrap" Margin="0,4,16,0" Visibility="Collapsed"/>
                    <TextBlock x:Name="ErrorText" Foreground="{DynamicResource Danger}" TextWrapping="Wrap" Margin="0,4,16,0" Visibility="Collapsed"/>
                    <WrapPanel>
                        <TextBlock x:Name="PendingText" Margin="0,4,16,0" Visibility="Collapsed">
                            <Hyperlink Click="ShowPrompt_Click"><Run x:Name="PendingRun"/></Hyperlink>
                        </TextBlock>
                        <TextBlock x:Name="DeferredText" Margin="0,4,16,0" Visibility="Collapsed">
                            <Hyperlink Click="ShowDeferred_Click"><Run x:Name="DeferredRun"/></Hyperlink>
                        </TextBlock>
                    </WrapPanel>
                    <TextBlock x:Name="UpdateBanner" Margin="0,4,0,0" Visibility="Collapsed">
                        <Run x:Name="UpdateBannerRun"/>
                        <Hyperlink Click="DownloadUpdate_Click">Open the download page</Hyperlink>
                    </TextBlock>
                </StackPanel>
            </DockPanel>
        </Border>

        <TabControl x:Name="Tabs" Margin="12" BorderBrush="{DynamicResource Line}">
            <!-- Rules -->
            <TabItem x:Name="RulesTab" Header="Rules">
                <DockPanel Margin="10">
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10" LastChildFill="False">
                        <TextBlock DockPanel.Dock="Left" Text="Search" VerticalAlignment="Center" Foreground="{DynamicResource Muted}" Margin="0,0,8,0"/>
                        <TextBox x:Name="SearchBox" DockPanel.Dock="Left" Width="240" Padding="4,3" VerticalContentAlignment="Center" TextChanged="Search_TextChanged"/>
                        <CheckBox x:Name="ShowWindowsRules" DockPanel.Dock="Left" Margin="16,0,0,0" VerticalAlignment="Center"
                                  Content="Show automatic Windows rules" Checked="Filter_Changed" Unchecked="Filter_Changed"/>
                        <Button DockPanel.Dock="Right" Content="Refresh" Click="Refresh_Click"/>
                        <Button DockPanel.Dock="Right" Content="Delete" Margin="0,0,8,0" Click="Delete_Click"/>
                        <Button x:Name="EditButton" DockPanel.Dock="Right" Content="Edit…" Margin="0,0,8,0" Click="Edit_Click"
                                IsEnabled="False" ToolTipService.ShowOnDisabled="True" ToolTip="Select a rule to edit."/>
                        <Button DockPanel.Dock="Right" Content="Block" Margin="0,0,8,0" Click="Block_Click"/>
                        <Button DockPanel.Dock="Right" Content="Allow" Margin="0,0,8,0" Click="Allow_Click"/>
                        <Button x:Name="RemoveMissingButton" DockPanel.Dock="Right" Margin="0,0,8,0" Click="RemoveMissing_Click"
                                Visibility="Collapsed" ToolTip="Delete the rules for programs that are no longer on this PC."/>
                    </DockPanel>

                    <!-- Apps the user chose to decide later about -->
                    <Border x:Name="DeferredPanel" DockPanel.Dock="Top" Margin="0,0,0,10" Padding="14,10" CornerRadius="6"
                            Background="{DynamicResource NoteBackground}" BorderBrush="{DynamicResource NoteBorder}" BorderThickness="1" Visibility="Collapsed">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                                <TextBlock Text="Waiting for your decision" FontWeight="SemiBold" Foreground="{DynamicResource Ink}"/>
                                <TextBlock Text="You chose to decide later about these apps. They're blocked until you decide."
                                           Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                            <ScrollViewer MaxHeight="170" VerticalScrollBarVisibility="Auto">
                                <ItemsControl x:Name="DeferredList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{DynamicResource NoteLine}" BorderThickness="0,1,0,0" Padding="0,6">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="2*"/>
                                                        <ColumnDefinition Width="3*"/>
                                                        <ColumnDefinition Width="2*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Image Source="{Binding Icon}" Width="20" Height="20" Margin="0,0,10,0" VerticalAlignment="Center"
                                                           RenderOptions.BitmapScalingMode="HighQuality"/>
                                                    <StackPanel Grid.Column="1" Margin="0,0,12,0" VerticalAlignment="Center" ToolTip="{Binding AppPath}">
                                                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" Foreground="{DynamicResource Ink}" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding Publisher}" Foreground="{DynamicResource Muted}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2" Margin="0,0,12,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding DestinationTitle}" Foreground="{DynamicResource Ink}" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding DestinationDetail}" Foreground="{DynamicResource Muted}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="3" Margin="0,0,12,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding DeferredText}" Foreground="{DynamicResource Ink}" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding AttemptsText}" Foreground="{DynamicResource Muted}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                    <Button Grid.Column="4" Content="Decide…" Style="{StaticResource PrimaryButton}" VerticalAlignment="Center"
                                                            Click="DecideNow_Click"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>
                    <TextBlock DockPanel.Dock="Bottom" Margin="0,8,0,0" Foreground="{DynamicResource Muted}" FontSize="12" TextWrapping="Wrap"
                               Text="These are ordinary Windows Firewall outbound rules (wf.msc › Outbound Rules, group “PacketHound”). Deleting a rule means PacketHound will ask about that app again."/>
                    <DataGrid x:Name="RulesGrid" SelectionChanged="RulesGrid_SelectionChanged" MouseDoubleClick="RulesGrid_DoubleClick">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Style.Triggers>
                                    <!-- Rules whose program is gone: a light red tint (selection still shows over it). -->
                                    <DataTrigger Binding="{Binding IsMissing}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource MissingRow}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Action" Width="110" SortMemberPath="Action">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <CheckBox Style="{StaticResource AllowSwitch}" IsChecked="{Binding IsAllow, Mode=OneWay}"
                                                      VerticalAlignment="Center" Click="RuleSwitch_Click"
                                                      ToolTip="Click to switch this app between Allow (green) and Block (red)."/>
                                            <TextBlock Text="{Binding Action}" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource BlockInk}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsAllow}" Value="True">
                                                                <Setter Property="Foreground" Value="{DynamicResource AllowInk}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Application" Binding="{Binding AppName}" Width="220"/>
                            <DataGridTextColumn Header="Applies to" Binding="{Binding AppliesTo}" Width="170"/>
                            <DataGridTextColumn Header="Program path" Binding="{Binding Path}" Width="*" MinWidth="240"/>
                            <DataGridTextColumn Header="Type" Binding="{Binding Kind}" Width="140"/>
                            <DataGridTextColumn Header="Created" Binding="{Binding Created}" SortMemberPath="CreatedDate" Width="130"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding State}" Width="140">
                                <DataGridTextColumn.CellStyle>
                                    <Style TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
                                        <Setter Property="ToolTip" Value="{Binding StateTip}"/>
                                    </Style>
                                </DataGridTextColumn.CellStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <!-- Activity -->
            <TabItem Header="Activity">
                <DockPanel Margin="10">
                    <TextBlock DockPanel.Dock="Top" Margin="0,0,0,8" TextWrapping="Wrap" Foreground="{DynamicResource Muted}"
                               Text="Outgoing connections the firewall blocked, and what happened next (kept for as long as set in Settings). Double-click a row to copy its IP address; right-click for more."/>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10" LastChildFill="False">
                        <TextBlock DockPanel.Dock="Left" Text="Search" VerticalAlignment="Center" Foreground="{DynamicResource Muted}" Margin="0,0,8,0"/>
                        <TextBox x:Name="ActivitySearchBox" DockPanel.Dock="Left" Width="240" Padding="4,3" VerticalContentAlignment="Center"
                                 TextChanged="ActivitySearch_TextChanged"
                                 ToolTip="App, host, IP address, protocol or result. :80 finds port 80. Separate words to narrow it down, e.g. chrome :80"/>
                        <TextBlock x:Name="ActivityCountText" DockPanel.Dock="Left" VerticalAlignment="Center" Margin="12,0,0,0"
                                   Foreground="{DynamicResource Muted}"/>
                        <Button DockPanel.Dock="Right" Content="Clear" Click="ClearActivity_Click"/>
                        <TextBlock x:Name="CopiedText" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="0,0,12,0"
                                   Foreground="{DynamicResource Success}" Visibility="Collapsed"/>
                    </DockPanel>
                    <DataGrid x:Name="ActivityGrid" MouseDoubleClick="ActivityGrid_DoubleClick" ContextMenuOpening="ActivityGrid_ContextMenuOpening">
                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem x:Name="DecideNowItem" Header="Decide now…" Click="ActivityDecideNow_Click"/>
                                <MenuItem x:Name="CopyAddressItem" Header="Copy IP address" Click="ActivityCopy_Click"/>
                                <MenuItem x:Name="CopyHostItem" Header="Copy host name" Click="ActivityCopyHost_Click"/>
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Time" Binding="{Binding TimeText}" SortMemberPath="Time" Width="140"/>
                            <DataGridTextColumn Header="Application" Binding="{Binding AppName}" Width="200"/>
                            <DataGridTextColumn Header="Destination" Binding="{Binding Destination}" Width="*" MinWidth="200"/>
                            <DataGridTextColumn Header="Protocol" Binding="{Binding Protocol}" Width="80"/>
                            <DataGridTextColumn Header="Result" Binding="{Binding Result}" Width="260"/>
                        </DataGrid.Columns>
                        <DataGrid.RowDetailsTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding AppPath}" Foreground="{DynamicResource Muted}" Margin="88,0,0,6"/>
                            </DataTemplate>
                        </DataGrid.RowDetailsTemplate>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <!-- Settings -->
            <TabItem Header="Settings">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="18" MaxWidth="760" HorizontalAlignment="Left">
                        <TextBlock Text="General" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <CheckBox x:Name="StartAtLogon" Content="Start PacketHound when I sign in" Margin="0,4" Click="StartAtLogon_Click"/>
                        <TextBlock Style="{StaticResource Label}" Margin="22,0,0,8" TextWrapping="Wrap"
                                   Text="Runs elevated through Task Scheduler, without a UAC prompt. While PacketHound isn't running, apps without a rule are blocked silently."/>

                        <TextBlock Text="Appearance" FontSize="15" FontWeight="SemiBold" Margin="0,16,0,8"/>
                        <WrapPanel>
                            <TextBlock Text="Theme" VerticalAlignment="Center" Margin="0,0,10,8"/>
                            <ComboBox x:Name="ThemeBox" MinWidth="160" Padding="8,4" Margin="0,0,0,8" SelectionChanged="Theme_Changed">
                                <ComboBoxItem Content="Same as Windows" Tag="System"/>
                                <ComboBoxItem Content="Light" Tag="Light"/>
                                <ComboBoxItem Content="Dark" Tag="Dark"/>
                            </ComboBox>
                        </WrapPanel>
                        <TextBlock Style="{StaticResource Label}" Margin="0,0,0,8" TextWrapping="Wrap"
                                   Text="“Same as Windows” follows the app mode in Windows Settings › Personalization › Colors, and switches when you change it there."/>

                        <TextBlock Text="Prompts" FontSize="15" FontWeight="SemiBold" Margin="0,16,0,8"/>
                        <WrapPanel>
                            <TextBlock Text="Duration starts on" Foreground="{DynamicResource Ink}" VerticalAlignment="Center" Margin="0,0,10,8"/>
                            <ComboBox x:Name="PromptDurationBox" MinWidth="160" Padding="8,4" Margin="0,0,0,8" SelectionChanged="PromptDuration_Changed">
                                <ComboBoxItem Content="Forever" Tag="Forever"/>
                                <ComboBoxItem Content="Until the app quits" Tag="UntilQuit"/>
                                <ComboBoxItem Content="For 1 hour" Tag="OneHour"/>
                                <ComboBoxItem Content="For the rest of today" Tag="RestOfToday"/>
                                <ComboBoxItem Content="Remember last selection" Tag="LastUsed"/>
                            </ComboBox>
                        </WrapPanel>
                        <TextBlock Style="{StaticResource Label}" Margin="0,0,0,8" TextWrapping="Wrap"
                                   Text="What the Duration list in the allow/block prompt is set to when it opens. You can still change it in each prompt. “Remember last selection” starts on whatever you chose with your last Allow or Block, even after a restart."/>

                        <TextBlock Text="Updates" FontSize="15" FontWeight="SemiBold" Margin="0,16,0,8"/>
                        <CheckBox x:Name="CheckForUpdates" Content="Check for updates automatically (once a week)" Margin="0,4" Click="CheckForUpdates_Click"/>
                        <TextBlock Style="{StaticResource Label}" Margin="22,0,0,8" TextWrapping="Wrap"
                                   Text="Asks packethound.app for the latest version number. Nothing about you or your PC is sent, and nothing is downloaded or installed: if there's a new version, PacketHound tells you and you download it yourself."/>
                        <WrapPanel Margin="0,0,0,4">
                            <Button x:Name="CheckNowButton" Content="Check now" Click="CheckNow_Click" Margin="0,0,12,8"/>
                            <Button x:Name="DownloadUpdateButton" Content="Open the download page" Style="{StaticResource PrimaryButton}"
                                    Click="DownloadUpdate_Click" Margin="0,0,12,8" Visibility="Collapsed"/>
                            <TextBlock x:Name="UpdateCheckText" Style="{StaticResource Value}" VerticalAlignment="Center" Margin="0,0,0,8"/>
                        </WrapPanel>

                        <TextBlock Text="Activity" FontSize="15" FontWeight="SemiBold" Margin="0,16,0,8"/>
                        <WrapPanel>
                            <TextBlock Text="Keep the Activity list for" Foreground="{DynamicResource Ink}" VerticalAlignment="Center" Margin="0,0,10,8"/>
                            <ComboBox x:Name="ActivityKeepBox" MinWidth="160" Padding="8,4" Margin="0,0,0,8" SelectionChanged="ActivityKeep_Changed">
                                <ComboBoxItem Content="This session only" Tag="0"/>
                                <ComboBoxItem Content="1 day" Tag="1"/>
                                <ComboBoxItem Content="7 days" Tag="7"/>
                                <ComboBoxItem Content="30 days" Tag="30"/>
                            </ComboBox>
                        </WrapPanel>
                        <TextBlock Style="{StaticResource Label}" Margin="0,0,0,8" TextWrapping="Wrap"
                                   Text="Saved in the log folder, so what was blocked while you were away is still listed after a restart. The list shows the latest 5,000 entries."/>

                        <TextBlock Text="What counts as Windows" FontSize="15" FontWeight="SemiBold" Margin="0,16,0,8"/>
                        <TextBlock Style="{StaticResource Label}" TextWrapping="Wrap" Margin="0,0,0,8"
                                   Text="Programs in Windows folders that are owned by TrustedInstaller/SYSTEM and carry a valid Microsoft Windows signature are allowed silently, and so is the Windows kernel. Everything else gets a prompt, including vendor tools that drivers install into System32."/>
                        <CheckBox x:Name="StoreAppsAsWindows" Content="Treat Microsoft-published Store apps (Photos, Store, Widgets…) as part of Windows" Margin="0,4" Click="ClassifierSetting_Click"/>
                        <CheckBox x:Name="AskForTools" Content="Still ask before PowerShell, cmd, curl, rundll32, mshta and similar Windows tools connect" Margin="0,4" Click="ClassifierSetting_Click"/>
                        <TextBlock Style="{StaticResource Label}" Margin="22,0,0,8" TextWrapping="Wrap"
                                   Text="Malware often uses these built-in tools to download payloads, so asking is safer."/>

                        <TextBlock Text="Windows Firewall" FontSize="15" FontWeight="SemiBold" Margin="0,16,0,8"/>
                        <TextBlock x:Name="FirewallInfo" Style="{StaticResource Value}" Margin="0,0,0,10"/>
                        <WrapPanel>
                            <Button Content="Open Windows Firewall (wf.msc)" Click="OpenWfMsc_Click" Margin="0,0,8,8"/>
                            <Button Content="Open log folder" Click="OpenLogs_Click" Margin="0,0,8,8"/>
                        </WrapPanel>

                        <TextBlock Text="Uninstall" FontSize="15" FontWeight="SemiBold" Margin="0,16,0,8"/>
                        <TextBlock Style="{StaticResource Label}" TextWrapping="Wrap" Margin="0,0,0,8"
                                   Text="Restores Windows Firewall's original outbound behaviour and audit settings, removes the startup task and, optionally, every PacketHound rule. Run this before deleting PacketHound."/>
                        <WrapPanel>
                            <Button Content="Restore Windows defaults (keep my rules)" Click="RestoreKeep_Click" Margin="0,0,8,8"/>
                            <Button Content="Restore defaults and delete all PacketHound rules" Style="{StaticResource DangerButton}" Click="RestoreRemove_Click" Margin="0,0,8,8"/>
                        </WrapPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
