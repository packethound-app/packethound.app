<!-- Light colours. Dark.xaml has the same keys; Theme.cs swaps one for the other.
     Use these with DynamicResource so a theme change reaches controls that are already open. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="Accent" Color="#2563EB"/>
    <SolidColorBrush x:Key="AccentHover" Color="#1D4ED8"/>
    <SolidColorBrush x:Key="Danger" Color="#DC2626"/>
    <SolidColorBrush x:Key="DangerHover" Color="#B91C1C"/>
    <SolidColorBrush x:Key="Success" Color="#16A34A"/>
    <SolidColorBrush x:Key="Warning" Color="#D97706"/>
    <SolidColorBrush x:Key="Ink" Color="#111827"/>
    <SolidColorBrush x:Key="Muted" Color="#6B7280"/>
    <SolidColorBrush x:Key="Line" Color="#E5E7EB"/>
    <SolidColorBrush x:Key="Surface" Color="#F3F4F6"/>
    <SolidColorBrush x:Key="SurfaceHover" Color="#E9EBEF"/>
    <SolidColorBrush x:Key="Window" Color="#FFFFFF"/>
    <!-- Behind the logo in the main window -->
    <SolidColorBrush x:Key="LogoPlate" Color="Transparent"/>
    <!-- Text boxes, combo boxes, check boxes and lists -->
    <SolidColorBrush x:Key="Field" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="FieldBorder" Color="#C4C8CF"/>
    <SolidColorBrush x:Key="Link" Color="#0066CC"/>
    <!-- Selected rows: in the focused list, and in a list that doesn't have focus -->
    <SolidColorBrush x:Key="Selection" Color="#0078D7"/>
    <SolidColorBrush x:Key="SelectionInk" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SelectionInactive" Color="#E5E7EB"/>
    <SolidColorBrush x:Key="ScrollThumb" Color="#C1C5CC"/>
    <SolidColorBrush x:Key="ScrollThumbHover" Color="#9CA3AF"/>
    <!-- Allow/Block words in the Rules list -->
    <SolidColorBrush x:Key="AllowInk" Color="#15803D"/>
    <SolidColorBrush x:Key="BlockInk" Color="#B91C1C"/>
    <!-- Rules whose program is gone -->
    <SolidColorBrush x:Key="MissingRow" Color="#FEF2F2"/>
    <!-- Amber note (decide-later list, temp-folder and warning notes) -->
    <SolidColorBrush x:Key="NoteBackground" Color="#FFFBEB"/>
    <SolidColorBrush x:Key="NoteBorder" Color="#FCD34D"/>
    <SolidColorBrush x:Key="NoteLine" Color="#FDE68A"/>
    <!-- Blue note ("same as before") -->
    <SolidColorBrush x:Key="InfoBackground" Color="#EFF6FF"/>
    <SolidColorBrush x:Key="InfoBorder" Color="#BFDBFE"/>
</ResourceDictionary>
